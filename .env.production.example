# ══════════════════════════════════════════════════════════════════════════════
# MewDrive Backend — Production Environment Template
# Salin file ini ke .env di server production, lalu isi semua nilai.
# JANGAN commit file .env yang sudah diisi ke git.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
API_URL=https://api.yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://dbuser:STRONG_PASSWORD@localhost:5432/MewDrive_prod

# Pool tuning (opsional — default sudah cukup untuk 2-10 user)
# DB_POOL_MAX=20
# DB_POOL_MIN=5

# ─── JWT ──────────────────────────────────────────────────────────────────────
# WAJIB diganti! Gunakan string random minimal 64 karakter.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GANTI_DENGAN_STRING_RANDOM_PANJANG_MINIMAL_64_KARAKTER
JWT_EXPIRES_IN=7d

# ─── Security ─────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Production: tetap ketat (jangan naikkan GENERAL_RATE_LIMIT_MAX di production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# ─── Storage ──────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=/var/MewDrive/storage

# ─── Upload ───────────────────────────────────────────────────────────────────
# Max file size dalam bytes (default 10MB = 10485760)
MAX_FILE_SIZE=524288000

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=warn

# ─── Server Timeouts (opsional) ───────────────────────────────────────────────
# SHUTDOWN_TIMEOUT_MS=10000
# KEEP_ALIVE_TIMEOUT_MS=65000
# HEADERS_TIMEOUT_MS=66000
