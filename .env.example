# ── Application ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# ── Database ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:password@127.0.0.1:5432/purrdocs

# ── JWT ─────────────────────────────────────────────────────────────────────────
JWT_SECRET=ganti-ini-dengan-string-panjang-dan-random-di-production
JWT_EXPIRES_IN=7d

# ── Security ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=10

# ── Rate Limiting ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=5

# ── Logging ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Storage ─────────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/files

# ── Upload ──────────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760

# ── Performance & Scalability (Task 17) ────────────────────────────────────────
# Semua variabel di bawah OPSIONAL — ada default-nya jika tidak diisi.

# Database pool tuning
# DB_POOL_MAX=5              # default: 5 (dev) / 20 (prod)
# DB_POOL_MIN=1              # default: 1 (dev) / 5 (prod)
# DB_IDLE_TIMEOUT_MS=30000   # default: 30000 ms
# DB_CONNECT_TIMEOUT_MS=5000 # default: 5000 ms
# DB_STATEMENT_TIMEOUT_MS=10000 # default: 10000 ms — query >10 detik di-cancel

# Server timeout tuning
# SHUTDOWN_TIMEOUT_MS=10000     # default: 10000 ms
# KEEP_ALIVE_TIMEOUT_MS=65000   # default: 65000 ms
# HEADERS_TIMEOUT_MS=66000      # default: 66000 ms

# In-memory cache TTL
# CACHE_FILE_TTL_MS=30000     # default: 30000 ms
# CACHE_STORAGE_TTL_MS=10000  # default: 10000 ms

# ── Telegram (Task 5) ─────────────────────────────────────────────────────────
TELEGRAM_ENCRYPTION_KEY=  # 64 hex chars = 32 bytes untuk AES-256, generate dengan: openssl rand -hex 32

# ── CORS (Task 14) ────────────────────────────────────────────────────────────
# Production: set ke domain frontend (comma-separated untuk multi-domain)
# Contoh: CORS_ORIGINS=https://drive.example.com,https://www.drive.example.com
# Jika tidak diisi, fallback ke FRONTEND_URL
# CORS_ORIGINS=https://drive.example.com
